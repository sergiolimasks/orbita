#!/bin/bash
# XCloud360 — serve any ELF32 over HTTP so XeLL Reloaded can netboot it.
#
# XeLL Reloaded supports HTTP boot: from its menu, choose "Load from network"
# and it fetches a configured URL. Configure XeLL to point at
#   http://<devbox-ip>:8032/xenon.elf
# and press "boot" — it pulls, verifies, jumps to entry.
#
# Usage:
#   scripts/serve-xell                   # serve last-built hwtest (default)
#   scripts/serve-xell <PATH-TO-ELF>     # serve specific ELF
#   scripts/serve-xell <PATH-TO-ELF> <PORT>
#
# Examples:
#   scripts/serve-xell app/h264dec/h264dec.elf32
#   scripts/serve-xell app/rendertest2/rendertest2.elf32 8033
#
# Serves the repo root as web root. Symlinks selected artifact to
# build/xenon.elf for XeLL convention.

set -euo pipefail

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$ROOT"

ELF=""
PORT="8032"
if [ $# -ge 1 ] && [ -f "$1" ]; then
    ELF="$1"; shift || true
fi
if [ $# -ge 1 ]; then
    PORT="$1"
fi
if [ -z "$ELF" ]; then
    # legacy default: hwtest
    if   [ -f "$ROOT/app/hwtest/hwtest.elf32" ]; then ELF="$ROOT/app/hwtest/hwtest.elf32"
    elif [ -f "$ROOT/app/hwtest/hwtest.elf"   ]; then ELF="$ROOT/app/hwtest/hwtest.elf"
    else
        echo "[serve] WARN: pass an ELF path or build hwtest first" >&2
    fi
fi

mkdir -p "$ROOT/build"
if [ -n "$ELF" ]; then
    ln -sfn "$ELF" "$ROOT/build/xenon.elf"
    echo "[serve] linked build/xenon.elf → $ELF"
    du -h "$ELF" | awk '{printf "[serve] size:  %s\n", $1}'
fi

# Resolve serving IPs for the user.
echo "[serve] IPv4 addresses on this host:"
ip -4 -o addr show scope global | awk '{split($4, a, "/"); print "  "$2" "a[1]}'

echo "[serve] XeLL URL to configure:  http://<pick-ip-above>:$PORT/build/xenon.elf"
echo "[serve] Ctrl+C to stop."
echo ""

# Python's stdlib http.server is enough — bind all interfaces.
exec python3 -m http.server "$PORT" --bind 0.0.0.0 --directory "$ROOT"
