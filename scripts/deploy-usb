#!/bin/bash
# XCloud360 — copy a built .elf32 to a FAT/exFAT USB drive as /xenon.elf
# (XeLL convention). Attempts to find a mounted USB drive automatically;
# override with --target /mnt/point.
#
# Usage:
#   scripts/deploy-usb app/hwtest/hwtest.elf32
#   scripts/deploy-usb app/hwtest/hwtest.elf32 --target /media/srglimasks/PENDRIVE

set -euo pipefail

LOCAL="${1:-}"
if [ -z "$LOCAL" ] || [ ! -f "$LOCAL" ]; then
    echo "ERROR: local file required and must exist. Got: '$LOCAL'" >&2
    echo "Usage: $0 <local-file> [--target /mnt/point]" >&2
    exit 1
fi

TARGET=""
if [ "${2:-}" = "--target" ] && [ -n "${3:-}" ]; then
    TARGET="$3"
fi

if [ -z "$TARGET" ]; then
    # Try to find a removable, mounted FAT/exFAT filesystem.
    CANDIDATES=$(lsblk -rnpo NAME,RM,FSTYPE,MOUNTPOINT | awk '$2=="1" && ($3=="vfat"||$3=="exfat") && $4!="" {print $4}')
    COUNT=$(echo "$CANDIDATES" | grep -c . || true)
    if [ "$COUNT" -eq 0 ]; then
        echo "ERROR: no removable FAT/exFAT drives mounted. Plug the USB pendrive and re-run." >&2
        echo "Or pass --target /path/to/mount/point manually." >&2
        exit 2
    elif [ "$COUNT" -gt 1 ]; then
        echo "ERROR: multiple removable drives — specify with --target:" >&2
        echo "$CANDIDATES" | sed 's/^/  /' >&2
        exit 3
    fi
    TARGET="$CANDIDATES"
fi

if [ ! -d "$TARGET" ] || [ ! -w "$TARGET" ]; then
    echo "ERROR: target '$TARGET' not writable" >&2
    exit 4
fi

DEST="$TARGET/xenon.elf"
echo "[usb] $LOCAL → $DEST"
cp -v "$LOCAL" "$DEST"
sync
echo "[usb] synced. Safely eject and plug into the Xbox 360."
echo "[usb] Boot with the Eject button pressed (or via Aurora/FSD 'Launch XeLL')"
echo "[usb] to have XeLL scan USB and load xenon.elf automatically."
