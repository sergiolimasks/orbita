# Exemplo de configuração (NÃO coloque valores reais no repo).
# Em produção cada segredo é um "docker secret" lido de /run/secrets/<nome>;
# localmente dá pra usar as variáveis abaixo (ou NOME_FILE=caminho).

# docker secret xc360_site_secret  -> chave de assinatura do cookie de sessão
SECRET_KEY=troque-por-64-bytes-aleatorios
# docker secret xc360_site_keyenc  -> chave Fernet (cifra o segredo TOTP do admin)
KEYENC_KEY=gerar-com-python-c-from-cryptography.fernet-import-Fernet;print(Fernet.generate_key().decode())
# docker secret xc360_site_db      -> DSN do Postgres (role xc360, banco xc360)
DATABASE_URL=postgresql://xc360:SENHA@postgres:5432/xc360
# docker secret xc360_site_r2      -> conteúdo no formato de ~/credentials/xc360-r2.env
R2_ENV="R2_ACCOUNT=...\nR2_ACCESS=...\nR2_SECRET=...\nR2_BUCKET=xcloud360-logs"

# não secretos
BASE_URL=https://x360.pistatrack.com
VIDEO_EMBED_URL=            # ex.: https://www.youtube-nocookie.com/embed/<id> (vazio = "em breve")
LOG_SYNC_INTERVAL=300       # segundos entre sincronizações do índice de logs (0 = desliga)
BRIDGE_TOKEN=troque-por-um-segredo-longo   # /_bridge/check (igual ao xc360_bridge_token da ponte)
