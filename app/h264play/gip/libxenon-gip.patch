diff -ruN
--- a/drivers/usb/usbgip.c	1969-12-31 21:00:00.000000000 -0300
+++ b/drivers/usb/usbgip.c	2026-10-27 04:04:42.107143666 -0300
@@ -0,0 +1,772 @@
+/*
+ * usbgip.c - libxenon driver for WIRED Xbox One / One S / Elite / Series X|S
+ * pads (and third-party GIP pads) over USB.
+ *
+ * The pad shows up to the app as an ordinary libxenon controller: reports
+ * are decoded by gip_proto.c into struct controller_data_s and published
+ * with set_controller_data() on a slot shared with usbctrl.c (360 pads), so
+ * a One pad and a 360 pad can be plugged at the same time.
+ *
+ * Two start-up modes:
+ *  - HOST (Microsoft pads, VID 045e): the sequence that works for 045e:0b12
+ *    on this console under the retail kernel (XboxInput v1.2, GPL-3.0) and
+ *    that Windows uses (riffmaster-rgh360 docs/PROTOCOL.md capture):
+ *      SET_CONFIGURATION, open OUT + IN (bInterval honoured), early power-on
+ *      05 20 00 01 00, start reading when it completes; on ANNOUNCE send
+ *      IDENTIFY 04 20 ss 00 (re-sent at most once a second while the pad keeps
+ *      announcing); ack the chunked identify reply; on its last chunk send the
+ *      15-byte locale POWER, power-on and LED.  No SET_INTERFACE, no auth.
+ *  - XPAD (third-party pads): the Linux xpad sequence (SET_INTERFACE(1,0),
+ *    power-on/LED/auth-done + per-PID quirks at attach, re-sent on announce).
+ *
+ * Memory: everything is allocated once in attach (softc, two DMA buffers,
+ * one IN and one OUT usbreq) and freed in detach.  Both requests are reused
+ * for the life of the device: nothing is allocated per packet.
+ *
+ * Threading: like the rest of libxenon USB, everything here runs inside
+ * usb_do_poll() (XCloud360: only the network thread, hw thread 1).
+ * usbgip_set_rumble() must be called from that same thread.
+ *
+ * Diagnostics: every step goes through usblog() (RAM history, paced UDP).
+ */
+#include <input/input.h>
+#include "cfe.h"            /* hosttest/ supplies a mock with the same name */
+
+#include "usbchap9.h"
+#include "usbd.h"
+#include "gip_proto.h"
+#include "usblog.h"
+
+#define CACHE_ALIGN 128     /* Xenon cache line: keep DMA buffers on their own lines */
+#define BUFF_ALIGN  128
+#define GIP_ALIGN(n, a) (((n) + ((a) - 1)) & ~((a) - 1))
+#define gip_dma_alloc(n) (KMALLOC(GIP_ALIGN((n), CACHE_ALIGN), BUFF_ALIGN))
+#define gip_dma_free(p)  (KFREE(p))
+
+#define GIP_QLEN        16    /* power of two */
+#define GIP_MAX_PADS    4
+#define GIP_MAX_DEVS    8
+#if GIP_DEBUG
+#define GIP_LOG_RX      16    /* hex-dump the first N IN packets */
+#define GIP_LOG_TX      40    /* log the first N OUT packets (errors always, up to GIP_LOG_ERR) */
+#define GIP_DLOG(...)   usblog(__VA_ARGS__)
+#else
+#define GIP_LOG_RX      0     /* production: no per-packet lines */
+#define GIP_LOG_TX      0
+#define GIP_DLOG(...)   do { if (0) usblog(__VA_ARGS__); } while (0)
+#endif
+#define GIP_LOG_ERR     12
+#define GIP_RETRY_MS    3000  /* nothing received at all: resend the (early) power-on */
+#define GIP_MAX_RETRY   5
+#define GIP_READ_FORCE_MS 1000 /* early power-on never completed: start reading anyway */
+#define GIP_IDENT_MS    1000  /* identify re-send period while the pad keeps announcing */
+#define GIP_STATS_MS    10000
+#define GIP_STUCK_MS    1000
+
+/* 1 = GIP interrupt pipes polled at bInterval (usb_open_pipe_interval, 4 ms);
+ * 0 = stock libxenon placement (every interrupt ED on the 32 ms leaf).
+ * Bisect switch: variants/gip.elf32 = 1, variants/gip-slot32.elf32 = 0. */
+#ifndef GIP_OHCI_INTERVAL
+#define GIP_OHCI_INTERVAL 1
+#endif
+#define GIP_BC_N        8     /* breadcrumbs for the first N transfers each way */
+#define GIP_IN_BUF      512   /* IN DMA buffer (variant in512 reads 512 bytes) */
+#define GIP_DUMP_MS     250   /* raw OHCI ED/TD dump period while a pad is attached */
+#define GIP_DUMP_FOR_MS 60000 /* ... for the first minute after attach */
+
+/* v5 bisect: one variant per plug-in (cycling), so a single hardware session
+ * tests several.  base = v4.2 behaviour. */
+enum { GV_BASE, GV_NOCFG, GV_SETIF00, GV_ALT1, GV_IN32, GV_IN512, GV_2IN, GV_SEQ1, GV_N };
+static const char *const gv_name[GV_N] = {
+    "base", "no-setcfg", "setif0.0", "alt1", "in32", "in512", "2in", "seq1" };
+#ifndef GIP_VARIANT_CYCLE
+#define GIP_VARIANT_CYCLE GIP_DEBUG      /* production: always "base" */
+#endif
+int usbgip_force_variant = -1;   /* >= 0: always this one (host test) */
+static unsigned gip_plug_count;
+
+/* libxenon OHCI / usbctrl diagnostics (ohci.c, usbctrl.c) */
+extern int ohci_debug_ept(usbdev_t *dev, int epaddr, char *out, int cap);
+extern int ohci_debug_hc(usbbus_t *bus, char *out, int cap);
+extern usbdev_t *RFdev;
+extern unsigned usbctrl_rx_count;
+
+#define GIP_MODE_XPAD   0
+#define GIP_MODE_HOST   1
+
+/* shared with usbctrl.c (360 pads) so both drivers use the same 4 slots */
+extern int  usbctrl_slot_alloc(void);
+extern void usbctrl_slot_free(int slot);
+
+typedef struct usbgip_softc_s {
+    usbdev_t *dev;
+    int index;                 /* controller slot 0..3, -1 = none */
+    uint16_t vid, pid;
+    int mode;
+    int variant;
+    int in_len;                /* IN request length (mps, or 32/512 by variant) */
+    usbreq_t *ireq2;           /* variant 2in: a second IN request */
+    uint8_t *ibuf2;
+    uint64_t attach_ms, dump_ms, dump1s_ms;
+    int ep_in, ep_out;         /* endpoint addresses (usb_open_pipe) */
+    int mps_in, mps_out, ival_in, ival_out;
+    uint8_t *ibuf, *obuf;      /* DMA buffers, mps sized */
+    usbreq_t *ireq, *oreq;     /* reused forever; NULL once freed */
+    int read_started;
+    int out_busy;              /* oreq is queued in the HC */
+    uint64_t out_since_ms;     /* when oreq was queued */
+    int out_stuck_logged;
+    uint8_t cur_flags;         /* flags of the packet in flight */
+    uint8_t cur_cmd, cur_seq;
+    gip_pkt_t q[GIP_QLEN];
+    unsigned q_r, q_w;
+    uint8_t seq;
+    gip_state_t st;
+    /* HOST mode handshake */
+    uint64_t early_ms;         /* when the (last) early power-on was queued */
+    int identify_sent, identify_reply, identify_done, identify_tries;
+    uint64_t identify_ms;
+    /* both modes */
+    int init_runs;             /* how many times the init sequence was sent */
+    int init_retries;          /* timer-driven resends */
+    int init_ok;               /* last init sequence fully completed by the HC */
+    int init_err;              /* an init packet failed */
+    uint64_t init_ms;          /* when the last init sequence started */
+    int logged_input;
+    unsigned bc_tx, bc_rx, bc_out;
+    unsigned rx, rx_bytes, rx_last_stats, tx, tx_ok;
+    unsigned in_err, out_err, q_drops, n_err_logged;
+    int last_in_err, last_out_err;
+    uint64_t stats_ms;
+} usbgip_softc_t;
+
+static usbgip_softc_t *gip_pads[GIP_MAX_PADS];     /* by slot, for rumble */
+static usbgip_softc_t *gip_devs[GIP_MAX_DEVS];     /* every attached pad, for tick */
+
+static int usbgip_attach(usbdev_t *dev, usb_driver_t *drv);
+static int usbgip_detach(usbdev_t *dev);
+
+usb_driver_t usbgip_driver = {
+    "Xbox One controller (GIP)",
+    usbgip_attach,
+    usbgip_detach
+};
+
+/* ------------------------------------------------------------- slots */
+
+static void gip_take_slot(usbgip_softc_t *sc)
+{
+    if (sc->index >= 0) return;
+    sc->index = usbctrl_slot_alloc();
+    if (sc->index >= 0 && sc->index < GIP_MAX_PADS) {
+        gip_pads[sc->index] = sc;
+        GIP_DLOG("pad %04x:%04x got controller slot %d", sc->vid, sc->pid, sc->index);
+    }
+}
+
+static void gip_publish(usbgip_softc_t *sc)
+{
+    if (sc->index < 0) gip_take_slot(sc);   /* all 4 were busy at attach */
+    if (sc->index >= 0) set_controller_data(sc->index, &sc->st.c);
+}
+
+/* ------------------------------------------------------------- output */
+
+static int gip_out_cb(usbreq_t *ur);
+static void gip_kick(usbgip_softc_t *sc);
+static void gip_start_read(usbgip_softc_t *sc, const char *why);
+
+static int gip_enqueue(usbgip_softc_t *sc, const gip_pkt_t *p)
+{
+    if (sc->q_w - sc->q_r >= GIP_QLEN) {
+        if (sc->q_drops++ < 3) usblog("pad%d tx queue full, dropping cmd %02x", sc->index, p->data[0]);
+        return -1;
+    }
+    sc->q[sc->q_w % GIP_QLEN] = *p;
+    sc->q_w++;
+    return 0;
+}
+
+static int gip_dev_gone(usbgip_softc_t *sc)
+{
+    return (sc->dev->ud_flags & UD_FLAG_REMOVING) != 0;
+}
+
+static void gip_kick(usbgip_softc_t *sc)
+{
+    gip_pkt_t *p;
+    char hex[3 * 20 + 1];
+    if (sc->out_busy || !sc->oreq || sc->q_r == sc->q_w || gip_dev_gone(sc)) return;
+    p = &sc->q[sc->q_r % GIP_QLEN];
+    sc->q_r++;
+    if (p->flags & GIP_PF_STAMP_SEQ) p->data[2] = gip_next_seq(&sc->seq);
+    int n = p->len > sc->mps_out ? sc->mps_out : p->len;
+    memcpy(sc->obuf, p->data, n);
+    sc->cur_flags = p->flags;
+    sc->cur_cmd = p->data[0];
+    sc->cur_seq = p->data[2];
+    sc->oreq->ur_buffer = sc->obuf;
+    sc->oreq->ur_length = n;
+    sc->oreq->ur_flags = UR_FLAG_OUT;
+    sc->oreq->ur_callback = gip_out_cb;
+    sc->oreq->ur_ref = sc;
+    sc->out_busy = 1;
+    sc->out_stuck_logged = 0;
+    sc->out_since_ms = usblog_now_ms();
+    sc->tx++;
+    if (sc->tx <= GIP_LOG_TX) {
+        usblog_hex(hex, p->data, n, 20);
+        usblog("pad%d tx#%u%s ep 0x%02x len %d: %s", sc->index, sc->tx,
+               (p->flags & GIP_PF_INIT) ? " init" : "", sc->ep_out, n, hex);
+    }
+    if (sc->bc_tx < GIP_BC_N) usblog_bc("bc tx#%u queue OUT cmd %02x len %d", sc->tx, sc->cur_cmd, n);
+    int r = usb_queue_request(sc->oreq);
+    if (sc->bc_tx++ < GIP_BC_N) usblog_bc("bc tx#%u queued -> %d", sc->tx, r);
+    if (r != 0) {
+        usblog("pad%d tx#%u usb_queue_request returned %d (packet dropped)", sc->index, sc->tx, r);
+        sc->out_busy = 0;
+    }
+}
+
+static int gip_out_cb(usbreq_t *ur)
+{
+    usbgip_softc_t *sc = ur->ur_ref;
+    if (sc->bc_out++ < GIP_BC_N)
+        usblog_bc("bc out_cb tx#%u status %d xferred %d", sc->tx, ur->ur_status, ur->ur_xferred);
+    sc->out_busy = 0;
+
+    if (ur->ur_status == UR_ERR_CANCELLED || gip_dev_gone(sc)) {
+        usb_free_request(ur);
+        sc->oreq = NULL;
+        return 0;
+    }
+    if (ur->ur_status != 0) {
+        sc->out_err++;
+        sc->last_out_err = ur->ur_status;
+        if (sc->cur_flags & GIP_PF_INIT) sc->init_err = ur->ur_status;
+        if (sc->n_err_logged++ < GIP_LOG_ERR)
+            usblog("pad%d tx#%u cmd %02x seq %u FAILED: usb status %d (xferred %d)", sc->index,
+                   sc->tx, sc->cur_cmd, sc->cur_seq, ur->ur_status, ur->ur_xferred);
+    } else {
+        sc->tx_ok++;
+        if (sc->tx <= GIP_LOG_TX)
+            usblog("pad%d tx#%u done ok (%d bytes, %u ms)", sc->index, sc->tx, ur->ur_xferred,
+                   (unsigned)(usblog_now_ms() - sc->out_since_ms));
+    }
+    if (sc->cur_flags & GIP_PF_EARLY_POWER)
+        gip_start_read(sc, ur->ur_status ? "early power-on failed" : "early power-on done");
+    if (sc->cur_flags & GIP_PF_INIT_LAST) {
+        if (!sc->init_err) {
+            sc->init_ok = 1;
+            usblog("pad%d %04x:%04x init ok (run %d, %s, %s mode)", sc->index, sc->vid, sc->pid,
+                   sc->init_runs, gip_model_name(sc->vid, sc->pid),
+                   sc->mode == GIP_MODE_HOST ? "host" : "xpad");
+        } else {
+            usblog("pad%d %04x:%04x init FAILED (usb status %d)", sc->index, sc->vid,
+                   sc->pid, sc->init_err);
+        }
+    }
+    gip_kick(sc);
+    return 0;
+}
+
+/* XPAD mode: the whole xpad list at once */
+static void gip_xpad_init(usbgip_softc_t *sc, const char *why)
+{
+    gip_pkt_t init[GIP_MAX_INIT];
+    int i, n = gip_build_init(sc->vid, sc->pid, init, GIP_MAX_INIT);
+    sc->init_runs++;
+    sc->init_ok = 0;
+    sc->init_err = 0;
+    sc->init_ms = usblog_now_ms();
+    GIP_DLOG("pad%d init run %d (%s): %d xpad packets, tx queue %u, out %s", sc->index,
+           sc->init_runs, why, n, sc->q_w - sc->q_r, sc->out_busy ? "busy" : "idle");
+    for (i = 0; i < n; i++) gip_enqueue(sc, &init[i]);
+    gip_kick(sc);
+}
+
+/* HOST mode step 1: early power-on 05 20 00 01 00, then start reading */
+static void gip_host_early_power(usbgip_softc_t *sc, const char *why)
+{
+    gip_pkt_t p;
+    gip_build_power_on(&p, 1);
+    if (sc->variant == GV_SEQ1) p.data[2] = 1;       /* variant: sequence 1 instead of 0 */
+    p.flags |= GIP_PF_EARLY_POWER;
+    sc->early_ms = usblog_now_ms();
+    usblog_bc("bc pad%d early power-on (%s)", sc->index, why);
+    gip_enqueue(sc, &p);
+    gip_kick(sc);
+}
+
+/* HOST mode step 3: after the identify reply */
+static void gip_host_power_up(usbgip_softc_t *sc)
+{
+    gip_pkt_t p;
+    sc->init_runs++;
+    sc->init_ok = 0;
+    sc->init_err = 0;
+    sc->init_ms = usblog_now_ms();
+    usblog_bc("bc pad%d identify complete (%u chunks): locale POWER, power-on, LED", sc->index,
+           sc->st.n_identify);
+    gip_build_locale(&p);   p.flags |= GIP_PF_INIT; gip_enqueue(sc, &p);
+    gip_build_power_on(&p, 0); p.flags |= GIP_PF_INIT; gip_enqueue(sc, &p);
+    gip_build_led_on(&p);   p.flags |= GIP_PF_INIT | GIP_PF_INIT_LAST; gip_enqueue(sc, &p);
+    gip_kick(sc);
+}
+
+static void gip_host_send_identify(usbgip_softc_t *sc, const char *why)
+{
+    gip_pkt_t p;
+    gip_build_identify(&p);
+    sc->identify_sent = 1;
+    sc->identify_tries++;
+    sc->identify_ms = usblog_now_ms();
+    usblog_bc("bc pad%d -> IDENTIFY (%s, try %d)", sc->index, why, sc->identify_tries);
+    gip_enqueue(sc, &p);
+}
+
+int usbgip_set_rumble(int port, uint8_t l, uint8_t r)
+{
+    usbgip_softc_t *sc;
+    gip_pkt_t p;
+    if (port < 0 || port >= GIP_MAX_PADS || !(sc = gip_pads[port])) return -1;
+    gip_build_rumble(&p, l, r);
+    gip_enqueue(sc, &p);
+    gip_kick(sc);
+    return 0;
+}
+
+/* ------------------------------------------------------------- input */
+
+static void gip_handle_one(usbgip_softc_t *sc, int ev, const gip_pkt_t *ack, int len)
+{
+    uint64_t now = usblog_now_ms();
+    if (ev & GIP_EV_ACK) gip_enqueue(sc, ack);
+
+    if (ev & GIP_EV_ANNOUNCE) {
+        GIP_DLOG("pad%d announce #%u: vid %04x pid %04x", sc->index, sc->st.n_announce,
+               sc->st.ann_vid, sc->st.ann_pid);
+        if (sc->mode == GIP_MODE_HOST) {
+            if (sc->identify_done) {
+                /* the pad rebooted its GIP side: start over */
+                usblog("pad%d re-announced after power-up: restarting handshake", sc->index);
+                sc->identify_sent = sc->identify_reply = sc->identify_done = 0;
+                sc->identify_tries = 0;
+                sc->st.n_identify = 0;
+            }
+            if (!sc->identify_reply &&
+                (!sc->identify_sent || now - sc->identify_ms >= GIP_IDENT_MS))
+                gip_host_send_identify(sc, sc->identify_sent ? "pad still announcing" : "announce");
+        } else {
+            gip_xpad_init(sc, sc->st.n_announce > 1 ? "re-announce" : "announce");
+        }
+    }
+    if (ev & GIP_EV_IDENTIFY) sc->identify_reply = 1;
+    if ((ev & GIP_EV_IDENTIFY_DONE) && sc->mode == GIP_MODE_HOST && !sc->identify_done) {
+        sc->identify_done = 1;
+        gip_host_power_up(sc);
+    }
+    if (ev & (GIP_EV_INPUT | GIP_EV_GUIDE)) {
+        gip_publish(sc);
+        if (!sc->logged_input && (ev & GIP_EV_INPUT)) {
+            sc->logged_input = 1;
+            usblog("pad%d %04x:%04x first input (len %d, init %s)", sc->index, sc->vid,
+                   sc->pid, len, sc->init_ok ? "ok" : "pending");
+        }
+    }
+}
+
+static void gip_handle(usbgip_softc_t *sc, const uint8_t *b, int len)
+{
+    int off = 0, guard = 0;
+    while (off + 4 <= len && guard++ < 16) {       /* several GIP packets per transfer */
+        gip_pkt_t ack;
+        int used = 0;
+        int ev = gip_parse_ex(&sc->st, b + off, len - off, &ack, &used);
+        if (used <= 0) break;
+        gip_handle_one(sc, ev, &ack, used);
+        off += used;
+    }
+    gip_kick(sc);
+}
+
+static int gip_in_cb(usbreq_t *ur)
+{
+    usbgip_softc_t *sc = ur->ur_ref;
+    char hex[3 * 20 + 1];
+
+    if (ur->ur_status == UR_ERR_CANCELLED || gip_dev_gone(sc)) {
+        if (ur == sc->ireq2) sc->ireq2 = NULL; else sc->ireq = NULL;
+        usb_free_request(ur);
+        return 0;
+    }
+    int bc = sc->bc_rx++ < GIP_BC_N;
+    if (bc) usblog_bc("bc in_cb #%u status %d xferred %d", sc->bc_rx, ur->ur_status, ur->ur_xferred);
+    if (ur->ur_status == 0 || ur->ur_status == UR_ERR_DATAUNDERRUN) {
+        sc->rx++;
+        sc->rx_bytes += ur->ur_xferred;
+        if (sc->rx <= GIP_LOG_RX) {
+            usblog_hex(hex, ur->ur_buffer, ur->ur_xferred, 20);
+            usblog("pad%d rx#%u st %d len %d: %s", sc->index, sc->rx, ur->ur_status,
+                   ur->ur_xferred, hex);
+        }
+        gip_handle(sc, ur->ur_buffer, ur->ur_xferred);
+        if (bc) usblog_bc("bc in_cb #%u parsed", sc->bc_rx);
+    } else {
+        sc->in_err++;
+        sc->last_in_err = ur->ur_status;
+        if (sc->n_err_logged++ < GIP_LOG_ERR)
+            usblog("pad%d rx error: usb status %d (errors %u)", sc->index, ur->ur_status, sc->in_err);
+    }
+
+    ur->ur_length = sc->in_len;
+    ur->ur_flags = UR_FLAG_IN | UR_FLAG_SHORTOK;
+    if (usb_queue_request(ur) != 0) {   /* re-queueing also clears an OHCI ED halt */
+        sc->read_started = 0;           /* refused (HC out of TDs): tick retries */
+        sc->early_ms = usblog_now_ms();
+        usblog("pad%d IN re-queue refused, retrying from tick", sc->index);
+    }
+    if (bc) usblog_bc("bc in_cb #%u re-queued", sc->bc_rx);
+    return 0;
+}
+
+static void gip_start_read(usbgip_softc_t *sc, const char *why)
+{
+    int r;
+    if (sc->read_started || !sc->ireq || gip_dev_gone(sc)) return;
+    sc->read_started = 1;
+    sc->ireq->ur_callback = gip_in_cb;
+    sc->ireq->ur_ref = sc;
+    sc->ireq->ur_length = sc->in_len;
+    sc->ireq->ur_flags = UR_FLAG_IN | UR_FLAG_SHORTOK;
+    usblog_bc("bc first IN queue (%s)", why);
+    r = usb_queue_request(sc->ireq);
+    usblog_bc("bc first IN queued -> %d", r);
+    if (r != 0) { sc->read_started = 0; sc->early_ms = usblog_now_ms(); }
+    if (r == 0 && sc->ireq2 && !sc->ireq2->ur_inprogress) {
+        sc->ireq2->ur_callback = gip_in_cb;
+        sc->ireq2->ur_ref = sc;
+        sc->ireq2->ur_length = sc->in_len;
+        sc->ireq2->ur_flags = UR_FLAG_IN | UR_FLAG_SHORTOK;
+        int r2 = usb_queue_request(sc->ireq2);
+        GIP_DLOG("pad%d second IN TD queued -> %d", sc->index, r2);
+    }
+    GIP_DLOG("pad%d IN 0x%02x read queued (%s) -> %d, len %d, interval %d, variant %s", sc->index,
+           sc->ep_in, why, r, sc->in_len, sc->ival_in, gv_name[sc->variant]);
+}
+
+/* ------------------------------------------------------------- summary */
+
+/* one-line state of every GIP pad, for usblog's periodic summary line */
+int usbgip_summary(char *out, int cap)
+{
+    int i, n = 0, any = 0;
+    out[0] = 0;
+    for (i = 0; i < GIP_MAX_DEVS && n >= 0 && n < cap - 1; i++) {
+        usbgip_softc_t *sc = gip_devs[i];
+        if (!sc) continue;
+        any = 1;
+        n += snprintf(out + n, cap - n, " p%d %04x:%04x v=%s %s%s id%d/%d r%d rt%d tx%u/%u e%d rx%u in%u an%u ie%u/%d",
+                      sc->index, sc->vid, sc->pid, gv_name[sc->variant], sc->mode == GIP_MODE_HOST ? "H" : "X",
+                      sc->init_ok ? "init-ok" : "init-no", sc->identify_tries, sc->identify_done,
+                      sc->init_runs, sc->init_retries, sc->tx_ok, sc->tx, sc->last_out_err, sc->rx,
+                      sc->st.n_input, sc->st.n_announce, sc->in_err, sc->last_in_err);
+    }
+    if (!any && cap > 12) n = snprintf(out, cap, " no GIP pad");
+    if (n >= 0 && n < cap - 1) {
+        extern int ohci_td_low_water;
+        extern unsigned ohci_td_refused;
+        n += snprintf(out + n, cap - n, " tdmin%d/ref%u rfrx%u", ohci_td_low_water, ohci_td_refused,
+                      usbctrl_rx_count);
+    }
+    return n;
+}
+
+/* ------------------------------------------------------------- tick */
+
+/* Called from usb_do_poll() (usbmain.c) once per poll. */
+void usbgip_tick(void)
+{
+    int i;
+    uint64_t now = usblog_now_ms();
+    for (i = 0; i < GIP_MAX_DEVS; i++) {
+        usbgip_softc_t *sc = gip_devs[i];
+        if (!sc || gip_dev_gone(sc)) continue;
+
+        if (sc->mode == GIP_MODE_HOST) {
+            if (!sc->read_started && now - sc->early_ms >= GIP_READ_FORCE_MS)
+                gip_start_read(sc, "early power-on not completed after 1 s");
+            /* nothing at all received: the power-on may have been lost */
+            if (sc->read_started && sc->rx == 0 && sc->init_retries < GIP_MAX_RETRY &&
+                now - sc->early_ms >= GIP_RETRY_MS) {
+                sc->init_retries++;
+                usblog("pad%d nothing received %u ms after power-on (tx %u ok %u err %u last %d, "
+                       "rx_err %u last %d): retry %d/%d", sc->index, (unsigned)(now - sc->early_ms),
+                       sc->tx, sc->tx_ok, sc->out_err, sc->last_out_err, sc->in_err,
+                       sc->last_in_err, sc->init_retries, GIP_MAX_RETRY);
+                gip_host_early_power(sc, "retry timer");
+            }
+        } else if (!sc->st.have_input && sc->st.n_announce == 0 &&
+                   sc->init_retries < GIP_MAX_RETRY && now - sc->init_ms >= GIP_RETRY_MS) {
+            sc->init_retries++;
+            usblog("pad%d no announce/input %u ms after init (rx %u, rx_err %u last %d, "
+                   "tx %u ok %u err %u last %d): retry %d/%d", sc->index,
+                   (unsigned)(now - sc->init_ms), sc->rx, sc->in_err, sc->last_in_err, sc->tx,
+                   sc->tx_ok, sc->out_err, sc->last_out_err, sc->init_retries, GIP_MAX_RETRY);
+            gip_xpad_init(sc, "retry timer");
+        }
+        if (sc->out_busy && !sc->out_stuck_logged && now > sc->out_since_ms &&
+            now - sc->out_since_ms > GIP_STUCK_MS) {
+            sc->out_stuck_logged = 1;
+            usblog("pad%d tx#%u cmd %02x still not completed after %u ms (OUT never acked by HC)",
+                   sc->index, sc->tx, sc->cur_cmd, (unsigned)(now - sc->out_since_ms));
+        }
+#if GIP_DEBUG
+        /* raw OHCI state: is the IN ED ever visited by the HC? */
+        if (now - sc->attach_ms < GIP_DUMP_FOR_MS && now - sc->dump_ms >= GIP_DUMP_MS) {
+            char l[200];
+            sc->dump_ms = now;
+            ohci_debug_ept(sc->dev, sc->ep_in, l, sizeof(l));
+            usblog_quiet("dump pad%d v=%s rx%u IN %s", sc->index, gv_name[sc->variant], sc->rx, l);
+            if (now - sc->dump1s_ms >= 1000) {
+                sc->dump1s_ms = now;
+                ohci_debug_hc(sc->dev->ud_bus, l, sizeof(l));
+                usblog_quiet("dump %s", l);
+                ohci_debug_ept(sc->dev, sc->ep_out, l, sizeof(l));
+                usblog_quiet("dump pad%d OUT %s", sc->index, l);
+                if (RFdev) {
+                    ohci_debug_ept(RFdev, 0x81, l, sizeof(l));
+                    usblog_quiet("dump RF 02aa rx%u IN %s", usbctrl_rx_count, l);
+                }
+            }
+        }
+#endif
+        if (GIP_DEBUG && now - sc->stats_ms >= GIP_STATS_MS) {
+            sc->stats_ms = now;
+            usblog_quiet("pad%d stats: rx %u (+%u) in=%u guide=%u ann=%u ident=%u acks=%u rx_err %u "
+                         "(last %d) tx %u ok %u err %u (last %d) drops %u init %s runs %d",
+                         sc->index, sc->rx, sc->rx - sc->rx_last_stats, sc->st.n_input,
+                         sc->st.n_guide, sc->st.n_announce, sc->st.n_identify, sc->st.n_acks,
+                         sc->in_err, sc->last_in_err, sc->tx, sc->tx_ok, sc->out_err,
+                         sc->last_out_err, sc->q_drops, sc->init_ok ? "ok" : "not-ok", sc->init_runs);
+            sc->rx_last_stats = sc->rx;
+        }
+    }
+}
+
+/* ------------------------------------------------------------- attach */
+
+/* Log every interface/endpoint; return the interrupt IN/OUT endpoints of
+ * interface 0, alt 0 (the GIP data interface; 1 = audio, 2 = bulk).  xpad,
+ * xone and XboxInput all use alt 0 of interface 0 and never select alt 1. */
+static void gip_find_eps(usbdev_t *dev, usb_endpoint_descr_t **in, usb_endpoint_descr_t **out, int want_alt)
+{
+    static const char *tn[4] = { "ctrl", "isoc", "bulk", "intr" };
+    uint8_t *p, *end;
+    int cur_if = -1, cur_alt = -1;
+    *in = *out = NULL;
+    if (!dev->ud_cfgdescr) { usblog("  no config descriptor"); return; }
+    p = (uint8_t *)dev->ud_cfgdescr;
+    end = p + GETUSBFIELD(dev->ud_cfgdescr, wTotalLength);
+    while (p + 2 <= end) {
+        uint8_t blen = p[0], type = p[1];
+        if (blen < 2 || p + blen > end) {
+            usblog("  bad descriptor (len %u type %02x) at offset %d", blen, type,
+                   (int)(p - (uint8_t *)dev->ud_cfgdescr));
+            break;
+        }
+        if (type == USB_INTERFACE_DESCRIPTOR_TYPE && blen >= 9) {
+            cur_if = p[2];
+            cur_alt = p[3];
+            GIP_DLOG("  if %d alt %d: %d eps class %02x/%02x/%02x", p[2], p[3], p[4], p[5], p[6], p[7]);
+        } else if (type == USB_ENDPOINT_DESCRIPTOR_TYPE && blen >= 7) {
+            usb_endpoint_descr_t *ep = (usb_endpoint_descr_t *)p;
+            int t = ep->bmAttributes & USB_ENDPOINT_TYPE_MASK;
+            GIP_DLOG("    ep 0x%02x %s %s mps %d interval %d", ep->bEndpointAddress,
+                   USB_ENDPOINT_DIR_IN(ep->bEndpointAddress) ? "IN " : "OUT", tn[t & 3],
+                   GETUSBFIELD(ep, wMaxPacketSize), p[6]);
+            if (cur_if == 0 && cur_alt == want_alt && t == USB_ENDPOINT_TYPE_INTERRUPT) {
+                if (USB_ENDPOINT_DIR_IN(ep->bEndpointAddress)) { if (!*in) *in = ep; }
+                else if (!*out) *out = ep;
+            }
+        }
+        p += blen;
+    }
+}
+
+static void gip_free_softc(usbgip_softc_t *sc)
+{
+    int i;
+    for (i = 0; i < GIP_MAX_DEVS; i++) if (gip_devs[i] == sc) gip_devs[i] = NULL;
+    if (sc->ireq && !sc->ireq->ur_inprogress) { usb_free_request(sc->ireq); sc->ireq = NULL; }
+    if (sc->oreq && !sc->oreq->ur_inprogress) { usb_free_request(sc->oreq); sc->oreq = NULL; }
+    if (sc->ireq2 && !sc->ireq2->ur_inprogress) { usb_free_request(sc->ireq2); sc->ireq2 = NULL; }
+    if (sc->ireq || sc->oreq || sc->ireq2) {
+        /* still owned by the HC: leak the softc rather than risk a callback
+         * into freed memory (never seen: pipes are destroyed before detach) */
+        usblog("request still in flight at detach, leaking %u bytes", (unsigned)sizeof(*sc));
+        return;
+    }
+    if (sc->ibuf) gip_dma_free(sc->ibuf);
+    if (sc->ibuf2) gip_dma_free(sc->ibuf2);
+    if (sc->obuf) gip_dma_free(sc->obuf);
+    KFREE(sc);
+}
+
+static int usbgip_attach(usbdev_t *dev, usb_driver_t *drv)
+{
+    usb_config_descr_t *cfg = dev->ud_cfgdescr;
+    usb_endpoint_descr_t *epin, *epout;
+    usbgip_softc_t *sc;
+    int i, r;
+
+    dev->ud_drv = drv;
+    dev->ud_private = NULL;
+
+    uint16_t vid = GETUSBFIELD(&dev->ud_devdescr, idVendor);
+    uint16_t pid = GETUSBFIELD(&dev->ud_devdescr, idProduct);
+
+    usblog_bc("bc attach %04x:%04x (ival=%d build)", vid, pid, GIP_OHCI_INTERVAL);
+    usblog("attach %04x:%04x %s bus %d addr %d %s-speed cfg %d ifaces %d", vid, pid,
+           gip_model_name(vid, pid), dev->ud_bus ? dev->ud_bus->ub_num : -1, dev->ud_address,
+           (dev->ud_flags & UD_FLAG_LOWSPEED) ? "low" : "full",
+           cfg ? cfg->bConfigurationValue : -1, cfg ? cfg->bNumInterfaces : -1);
+    /* v5.1 cycle: base first (v4.2 + the uncached-descriptor fix), no-setcfg dropped */
+    static const int cycle[] = { GV_BASE, GV_SETIF00, GV_ALT1, GV_IN32, GV_IN512, GV_2IN, GV_SEQ1 };
+    int variant = usbgip_force_variant >= 0 ? usbgip_force_variant % GV_N :
+                  GIP_VARIANT_CYCLE ? cycle[gip_plug_count % (sizeof(cycle) / sizeof(cycle[0]))] : GV_BASE;
+    gip_plug_count++;
+    GIP_DLOG("%04x:%04x plug #%u: variant %s", vid, pid, gip_plug_count, gv_name[variant]);
+    gip_find_eps(dev, &epin, &epout, variant == GV_ALT1 ? 1 : 0);
+    usblog_bc("bc attach: eps in %p out %p", (void *)epin, (void *)epout);
+    if (!cfg || !epin || !epout) {
+        usblog("%04x:%04x: no interrupt IN/OUT on interface 0 alt 0, ignoring", vid, pid);
+        return 0;
+    }
+
+    sc = KMALLOC(sizeof(*sc), 0);
+    if (!sc) { usblog("attach: out of memory"); return -1; }
+    memset(sc, 0, sizeof(*sc));
+    sc->dev = dev;
+    sc->index = -1;
+    sc->vid = vid;
+    sc->pid = pid;
+    sc->mode = (vid == 0x045e) ? GIP_MODE_HOST : GIP_MODE_XPAD;
+    sc->variant = variant;
+    sc->attach_ms = usblog_now_ms();
+    sc->mps_in = GETUSBFIELD(epin, wMaxPacketSize);
+    sc->mps_out = GETUSBFIELD(epout, wMaxPacketSize);
+    sc->ival_in = epin->bInterval ? epin->bInterval : 4;
+    sc->ival_out = epout->bInterval ? epout->bInterval : 4;
+    if (sc->mps_in <= 0 || sc->mps_in > GIP_MAX_PKT) sc->mps_in = GIP_MAX_PKT;
+    if (sc->mps_out <= 0 || sc->mps_out > GIP_MAX_PKT) sc->mps_out = GIP_MAX_PKT;
+    sc->in_len = variant == GV_IN32 ? 32 : variant == GV_IN512 ? GIP_IN_BUF : sc->mps_in;
+    sc->ibuf = gip_dma_alloc(GIP_IN_BUF);
+    sc->obuf = gip_dma_alloc(GIP_MAX_PKT);
+    usblog_bc("bc attach: softc %p ibuf %p obuf %p", (void *)sc, (void *)sc->ibuf, (void *)sc->obuf);
+    if (!sc->ibuf || !sc->obuf) { usblog("attach: no DMA buffer"); goto fail; }
+    memset(sc->ibuf, 0, GIP_IN_BUF);
+    if (variant == GV_2IN) {
+        sc->ibuf2 = gip_dma_alloc(GIP_IN_BUF);
+        if (!sc->ibuf2) { usblog("attach: no DMA buffer"); goto fail; }
+    }
+
+    if (variant == GV_NOCFG) {
+        GIP_DLOG("variant no-setcfg: SET_CONFIGURATION skipped");
+    } else {
+        usblog_bc("bc attach: SET_CONFIGURATION");
+        r = usb_set_configuration(dev, cfg->bConfigurationValue);
+        GIP_DLOG("SET_CONFIGURATION %d -> %d (%s mode)", cfg->bConfigurationValue, r,
+               sc->mode == GIP_MODE_HOST ? "host" : "xpad");
+    }
+    if (variant == GV_SETIF00 || variant == GV_ALT1) {
+        int alt = variant == GV_ALT1 ? 1 : 0;
+        r = usb_simple_request(dev, USBREQ_DIR_OUT | USBREQ_TYPE_STD | USBREQ_REC_INTERFACE,
+                               USB_REQUEST_SET_INTERFACE, alt, 0);
+        GIP_DLOG("variant %s: SET_INTERFACE(0, alt %d) -> %d", gv_name[variant], alt, r);
+    }
+
+    /* xpad only: audio interface to alt 0 (some PowerA pads need it).
+     * XboxInput does NOT send it for Microsoft pads (incl. 0b12). */
+    if (sc->mode == GIP_MODE_XPAD && cfg->bNumInterfaces > 1) {
+        r = usb_simple_request(dev, USBREQ_DIR_OUT | USBREQ_TYPE_STD | USBREQ_REC_INTERFACE,
+                               USB_REQUEST_SET_INTERFACE, 0, 1);
+        GIP_DLOG("SET_INTERFACE(1, alt 0) -> %d", r);
+    }
+
+    /* OUT first then IN (same order as usbctrl.c), each scheduled at its
+     * bInterval instead of libxenon's default 32 ms interrupt leaf */
+#if GIP_OHCI_INTERVAL
+    usblog_bc("bc attach: open OUT 0x%02x ival %d", epout->bEndpointAddress, sc->ival_out);
+    sc->ep_out = usb_open_pipe_interval(dev, epout, sc->ival_out);
+    usblog_bc("bc attach: OUT -> %d; open IN 0x%02x ival %d", sc->ep_out, epin->bEndpointAddress, sc->ival_in);
+    sc->ep_in = usb_open_pipe_interval(dev, epin, sc->ival_in);
+    usblog_bc("bc attach: IN -> %d", sc->ep_in);
+#else
+    sc->ival_in = sc->ival_out = 32;    /* stock libxenon: the 32 ms leaf */
+    usblog_bc("bc attach: open OUT 0x%02x (stock 32 ms)", epout->bEndpointAddress);
+    sc->ep_out = usb_open_pipe(dev, epout);
+    usblog_bc("bc attach: OUT -> %d; open IN 0x%02x (stock 32 ms)", sc->ep_out, epin->bEndpointAddress);
+    sc->ep_in = usb_open_pipe(dev, epin);
+    usblog_bc("bc attach: IN -> %d", sc->ep_in);
+#endif
+    GIP_DLOG("pipes: in 0x%02x mps %d ival %d, out 0x%02x mps %d ival %d", sc->ep_in, sc->mps_in,
+           sc->ival_in, sc->ep_out, sc->mps_out, sc->ival_out);
+    if (sc->ep_in < 0 || sc->ep_out < 0) { usblog("attach: usb_open_pipe failed"); goto fail; }
+
+    sc->ireq = usb_make_request(dev, sc->ep_in, sc->ibuf, sc->in_len, UR_FLAG_IN | UR_FLAG_SHORTOK);
+    if (variant == GV_2IN)
+        sc->ireq2 = usb_make_request(dev, sc->ep_in, sc->ibuf2, sc->in_len, UR_FLAG_IN | UR_FLAG_SHORTOK);
+    sc->oreq = usb_make_request(dev, sc->ep_out, sc->obuf, 0, UR_FLAG_OUT);
+    if (!sc->ireq || !sc->oreq) { usblog("attach: usb_make_request failed"); goto fail; }
+    usblog_bc("bc attach: requests ireq %p oreq %p", (void *)sc->ireq, (void *)sc->oreq);
+
+    dev->ud_private = sc;
+    for (i = 0; i < GIP_MAX_DEVS; i++) if (!gip_devs[i]) { gip_devs[i] = sc; break; }
+    gip_take_slot(sc);
+    sc->stats_ms = usblog_now_ms();
+    usblog("pad%d connected %04x:%04x, variant %s, IN len %d", sc->index, vid, pid,
+           gv_name[variant], sc->in_len);
+
+    if (sc->mode == GIP_MODE_HOST) {
+        if (pid == 0x02d1) {
+            /* XboxInput: the 2013 pad announces without a power-on first */
+            sc->early_ms = usblog_now_ms();
+            gip_start_read(sc, "02d1: read before power-on");
+        } else {
+            gip_host_early_power(sc, "attach");
+        }
+    } else {
+        gip_start_read(sc, "xpad mode");
+        gip_xpad_init(sc, "attach");
+    }
+    usblog_bc("bc attach done");
+    return 0;
+
+fail:
+    usblog("%04x:%04x attach failed", vid, pid);
+    gip_free_softc(sc);
+    return -1;
+}
+
+static int usbgip_detach(usbdev_t *dev)
+{
+    usbgip_softc_t *sc = dev->ud_private;
+    if (!sc) return 0;
+    dev->ud_private = NULL;
+
+    if (sc->index >= 0) {
+        /* don't leave the last report latched (stuck stick / held button) */
+        struct controller_data_s zero;
+        memset(&zero, 0, sizeof(zero));
+        set_controller_data(sc->index, &zero);
+        if (sc->index < GIP_MAX_PADS && gip_pads[sc->index] == sc) gip_pads[sc->index] = NULL;
+        usbctrl_slot_free(sc->index);
+    }
+    usblog("pad%d (%04x:%04x) detached: rx %u in=%u guide=%u ann=%u ident=%u acks=%u rx_err %u "
+           "tx %u ok %u err %u drops %u", sc->index, sc->vid, sc->pid, sc->rx, sc->st.n_input,
+           sc->st.n_guide, sc->st.n_announce, sc->st.n_identify, sc->st.n_acks, sc->in_err,
+           sc->tx, sc->tx_ok, sc->out_err, sc->q_drops);
+    gip_free_softc(sc);
+    return 0;
+}
diff -ruN
