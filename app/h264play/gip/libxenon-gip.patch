--- a/drivers/usb/usblog.c	1969-12-31 21:00:00.000000000 -0300
+++ b/drivers/usb/usblog.c	2026-10-27 04:04:42.119147377 -0300
@@ -0,0 +1,283 @@
+/*
+ * usblog.c - USB/GIP diagnostics that survive boot and can never block.
+ *
+ * - usblog() only formats into a static history (first UL_BOOT lines since
+ *   boot + the last UL_RECENT).  It prints on the console only during the
+ *   boot phase (before UL_QUIET_MS); after that it is RAM-only, so nothing
+ *   slow (console scroll) ever runs on the network thread inside
+ *   usb_do_poll().
+ * - Nothing is sent from usblog() itself or from USB callbacks.  The only
+ *   caller of the app's np_log_line() (weak) is usblog_tick(), once per
+ *   usb_do_poll(), at most ONE line per UL_PACE_MS.  np_log_line() never
+ *   waits (it drops when its 64-line ring is full); we never loop.
+ * - Order of what a tick sends: the one-line summary (every UL_SUM_MS for the
+ *   first 2 minutes, then every 30 s), else the next unsent history line.
+ *   At UL_REPLAY_S[] the cursor rewinds to 0, so the whole history (boot
+ *   enumeration included) is re-sent: the UDP pipe does not exist yet while
+ *   USB enumerates at boot.  Lines overwritten before they were sent are
+ *   counted ("dropped").
+ * No malloc, no locks.
+ */
+#include <stdarg.h>
+#include <stdio.h>
+#include <string.h>
+#include "usblog.h"
+
+#ifdef GIP_HOSTTEST
+extern uint64_t mock_now_ms;
+uint64_t usblog_now_ms(void) { return mock_now_ms; }
+#else
+#include <ppc/timebase.h>
+uint64_t usblog_now_ms(void) { return mftb() / (PPC_TIMEBASE_FREQ / 1000); }
+#endif
+
+/* XCloud360 login/net_pipe.c: queues "LOG <text>" for UDP :9003, never
+ * blocks (drops when full).  Weak: other apps link and get nothing. */
+extern void np_log_line(const char *text) __attribute__((weak));
+/* usbgip.c: one-line state of every GIP pad (weak so usblog stands alone) */
+extern int usbgip_summary(char *out, int n) __attribute__((weak));
+
+#define UL_COLS     168
+#define UL_BOOT     96
+#define UL_RECENT   48
+#define UL_QUIET_MS 6000      /* console output only before this (boot / warm-up) */
+#define UL_PACE_MS  4         /* at most one UDP line per 4 ms (250/s) */
+#if GIP_DEBUG
+#define UL_SUM_MS   2000
+#else
+#define UL_SUM_MS   30000     /* production: one summary every 30 s */
+#endif
+#define UL_SUM_FAST_UNTIL_MS 120000
+#define UL_SUM_SLOW_MS 30000
+#define UL_ENUM_MAX 6
+
+static char ul_boot[UL_BOOT][UL_COLS];
+static char ul_recent[UL_RECENT][UL_COLS];
+static unsigned ul_total;              /* lines ever logged; line s lives in boot[s] or recent[] */
+static unsigned ul_cursor;             /* next line to send */
+static unsigned ul_dropped;            /* overwritten before being sent */
+static unsigned ul_sent;
+static uint64_t ul_t0, ul_last_send, ul_last_sum;
+static int ul_sum_pending = 1;
+static unsigned ul_ticks, ul_nsum;   /* heartbeat: usblog_tick calls, summaries sent */
+
+#if GIP_DEBUG
+static const unsigned ul_replay_s[] = { 8, 15, 25, 40, 60, 90, 180 };
+#define UL_NREPLAY (sizeof(ul_replay_s) / sizeof(ul_replay_s[0]))
+#else
+static const unsigned ul_replay_s[1] = { 0 };   /* production: no boot replay */
+#define UL_NREPLAY 0u
+#endif
+static unsigned ul_replay_no;
+
+/* short enumeration summary: "vid:pid>drv" of the last UL_ENUM_MAX devices */
+static char ul_enum[UL_ENUM_MAX][24];
+static unsigned ul_nenum;
+
+static uint64_t ul_rel(void)
+{
+    uint64_t t = usblog_now_ms();
+    if (!ul_t0) ul_t0 = t ? t : 1;
+    return t >= ul_t0 ? t - ul_t0 : 0;
+}
+
+static const char *ul_line(unsigned s)
+{
+    if (s < UL_BOOT) return s < ul_total ? ul_boot[s] : NULL;
+    if (s >= ul_total) return NULL;
+    if (ul_total - s > UL_RECENT) return NULL;     /* overwritten */
+    return ul_recent[(s - UL_BOOT) % UL_RECENT];
+}
+
+/* crash ring: the last UL_CRASH lines (100 chars) for the libxenon red
+ * screen (c_except.c calls usblog_crash_tail() through a weak hook) */
+#define UL_CRASH      10
+#define UL_CRASH_COLS 100
+static char ul_crash[UL_CRASH][UL_CRASH_COLS];
+static unsigned ul_ncrash;
+static int ul_force_console;
+
+static void ul_emit(int console, const char *fmt, va_list ap)
+{
+    char *dst;
+    char tmp[UL_COLS];
+    unsigned rel = (unsigned)ul_rel();
+    dst = ul_total < UL_BOOT ? ul_boot[ul_total] : ul_recent[(ul_total - UL_BOOT) % UL_RECENT];
+    int n = snprintf(tmp, sizeof(tmp), "[gip] t=%u.%03u ", rel / 1000, rel % 1000);
+    if (n < 0 || n >= (int)sizeof(tmp)) n = 0;
+    vsnprintf(tmp + n, sizeof(tmp) - n, fmt, ap);
+    tmp[UL_COLS - 1] = 0;
+    memcpy(dst, tmp, UL_COLS);
+    ul_total++;
+    memcpy(ul_crash[ul_ncrash % UL_CRASH], tmp + 6, UL_CRASH_COLS - 1);   /* drop "[gip] " */
+    ul_crash[ul_ncrash % UL_CRASH][UL_CRASH_COLS - 1] = 0;
+    ul_ncrash++;
+    if (console && (rel < UL_QUIET_MS || ul_force_console)) printf("%s\n", tmp);
+}
+
+/* breadcrumb: like usblog, but always on the console (first UL_BC_MAX) */
+#define UL_BC_MAX 64
+static unsigned ul_nbc;
+void usblog_bc(const char *fmt, ...)
+{
+    va_list ap;
+#if GIP_DEBUG
+    ul_force_console = ul_nbc++ < UL_BC_MAX;
+    va_start(ap, fmt); ul_emit(1, fmt, ap); va_end(ap);
+    ul_force_console = 0;
+#else
+    /* production: only into the crash-screen ring (no console, no UDP) */
+    char tmp[UL_CRASH_COLS];
+    unsigned rel = (unsigned)ul_rel();
+    int n = snprintf(tmp, sizeof(tmp), "t=%u.%03u ", rel / 1000, rel % 1000);
+    if (n < 0 || n >= (int)sizeof(tmp)) n = 0;
+    va_start(ap, fmt); vsnprintf(tmp + n, sizeof(tmp) - n, fmt, ap); va_end(ap);
+    memcpy(ul_crash[ul_ncrash % UL_CRASH], tmp, UL_CRASH_COLS);
+    ul_crash[ul_ncrash % UL_CRASH][UL_CRASH_COLS - 1] = 0;
+    ul_ncrash++;
+    (void)ul_nbc;
+#endif
+}
+
+/* Called from the crash handler (exception context): no locks, no malloc,
+ * only string copies into a static buffer. */
+const char *usblog_crash_tail(void)
+{
+    static char out[UL_CRASH * (UL_CRASH_COLS + 1) + 320];
+    unsigned i, first = ul_ncrash > UL_CRASH ? ul_ncrash - UL_CRASH : 0;
+    size_t n, k;
+    static const char h[] = "\n[gip] state:";
+    static const char h2[] = "\n[gip] last log lines (oldest first):\n";
+    memcpy(out, h, sizeof(h) - 1);
+    n = sizeof(h) - 1;
+    if (usbgip_summary) {                       /* pad state + OHCI TD low-water, one line */
+        int k2 = usbgip_summary(out + n, 160);
+        if (k2 > 0) n += (k2 < 159 ? (size_t)k2 : 159);
+    }
+    memcpy(out + n, h2, sizeof(h2) - 1);
+    n += sizeof(h2) - 1;
+    for (i = first; i < ul_ncrash; i++) {
+        const char *l = ul_crash[i % UL_CRASH];
+        for (k = 0; k < UL_CRASH_COLS - 1 && l[k]; k++) ;
+        if (n + k + 2 >= sizeof(out)) break;
+        memcpy(out + n, l, k);
+        n += k;
+        out[n++] = '\n';
+    }
+    out[n] = 0;
+    return out;
+}
+
+void usblog(const char *fmt, ...)
+{
+    va_list ap; va_start(ap, fmt); ul_emit(1, fmt, ap); va_end(ap);
+}
+
+void usblog_quiet(const char *fmt, ...)
+{
+    va_list ap; va_start(ap, fmt); ul_emit(0, fmt, ap); va_end(ap);
+}
+
+void usblog_note_enum(unsigned vid, unsigned pid, const char *drv)
+{
+    char *d = ul_enum[ul_nenum % UL_ENUM_MAX];
+    char s[8];
+    /* 3-4 letter driver tag */
+    if (!drv) snprintf(s, sizeof(s), "NONE");
+    else if (strstr(drv, "GIP")) snprintf(s, sizeof(s), "GIP");
+    else if (strstr(drv, "360")) snprintf(s, sizeof(s), "x360");
+    else if (strstr(drv, "ummy")) snprintf(s, sizeof(s), "dumm");
+    else if (strstr(drv, "ub") || strstr(drv, "UB")) snprintf(s, sizeof(s), "hub");
+    else snprintf(s, sizeof(s), "%.4s", drv);
+    snprintf(d, 24, "%04x:%04x>%s", vid & 0xffff, pid & 0xffff, s);
+    ul_nenum++;
+    ul_sum_pending = 1;
+}
+
+void usblog_hex(char *out, const uint8_t *b, int n, int max)
+{
+    static const char hx[] = "0123456789abcdef";
+    int i, k = 0;
+    if (n > max) n = max;
+    for (i = 0; i < n; i++) {
+        out[k++] = hx[b[i] >> 4];
+        out[k++] = hx[b[i] & 15];
+        if (i + 1 < n) out[k++] = ' ';
+    }
+    out[k] = 0;
+}
+
+static void ul_build_summary(char *out, int cap)
+{
+    unsigned i, first = ul_nenum > UL_ENUM_MAX ? ul_nenum - UL_ENUM_MAX : 0;
+    unsigned rel = (unsigned)ul_rel();
+    int n = snprintf(out, cap, "[gip] sum#%u t=%u hb%u log %u/%u skip %u enum%u:", ul_nsum, rel / 1000,
+                     ul_ticks, ul_sent, ul_total, ul_dropped, ul_nenum);
+    for (i = first; i < ul_nenum && n > 0 && n < cap - 1; i++)
+        n += snprintf(out + n, cap - n, " %s", ul_enum[i % UL_ENUM_MAX]);
+    if (n > 0 && n < cap - 1 && usbgip_summary) {
+        n += snprintf(out + n, cap - n, " |");
+        if (n < cap - 1) usbgip_summary(out + n, cap - n);
+    }
+    out[cap - 1] = 0;
+}
+
+void usblog_tick(void)
+{
+    char buf[212];             /* app pipe: 220 cols incl. "LOG " */
+    uint64_t rel = ul_rel();
+    ul_ticks++;
+    if (!np_log_line) return;
+
+#if GIP_DEBUG
+    /* replay points: rewind the cursor (cheap; the sending is paced below) */
+    if (ul_replay_no < UL_NREPLAY && rel >= (uint64_t)ul_replay_s[ul_replay_no] * 1000) {
+        ul_replay_no++;
+        ul_cursor = 0;
+        ul_sum_pending = 1;
+    }
+#else
+    (void)ul_replay_s; (void)ul_replay_no;
+#endif
+    if (rel - ul_last_send < UL_PACE_MS && ul_last_send) return;
+
+    uint64_t every = rel < UL_SUM_FAST_UNTIL_MS ? UL_SUM_MS : UL_SUM_SLOW_MS;
+    if (ul_sum_pending || rel - ul_last_sum >= every) {
+        ul_build_summary(buf, sizeof(buf));
+        ul_nsum++;
+        np_log_line(buf);
+        ul_sum_pending = 0;
+        ul_last_sum = rel;
+        ul_last_send = rel ? rel : 1;
+        return;
+    }
+    while (ul_cursor < ul_total) {           /* bounded: only skips lost lines */
+        const char *l = ul_line(ul_cursor);
+        if (l) break;
+        /* overwritten: jump to the oldest line still held */
+        unsigned oldest = ul_total > UL_BOOT + UL_RECENT ? ul_total - UL_RECENT : UL_BOOT;
+        if (oldest <= ul_cursor) oldest = ul_cursor + 1;
+        ul_dropped += oldest - ul_cursor;
+        ul_cursor = oldest;
+    }
+    if (ul_cursor < ul_total) {
+        np_log_line(ul_line(ul_cursor));
+        ul_cursor++;
+        ul_sent++;
+        ul_last_send = rel ? rel : 1;
+    }
+}
+
+/* 1 if one of the last n logged lines contains s (host test / debugging) */
+int usblog_find(const char *s, unsigned n)
+{
+    unsigned k;
+    for (k = 0; k < n && k < ul_total; k++) {
+        const char *l = ul_line(ul_total - 1 - k);
+        if (l && strstr(l, s)) return 1;
+    }
+    return 0;
+}
+
+unsigned usblog_total(void) { return ul_total; }
+unsigned usblog_dropped(void) { return ul_dropped; }
diff -ruN
--- a/drivers/usb/usblog.h	1969-12-31 21:00:00.000000000 -0300
+++ b/drivers/usb/usblog.h	2026-10-27 04:04:42.123074754 -0300
@@ -0,0 +1,36 @@
+/*
+ * usblog.h - USB/GIP diagnostics that survive boot and can never block.
+ * See usblog.c for the rules (RAM-only after boot, one paced UDP line per
+ * usb_do_poll through the app's weak np_log_line, replays, summary line).
+ */
+#ifndef USBLOG_H
+#define USBLOG_H
+
+/* 0 = production (installed libxenon): key lines only, summary every 30 s,
+ * no boot replay, breadcrumbs only in the crash-screen ring, console only
+ * during the first 6 s.  1 = diagnostic build (dumps, variants, replay). */
+#ifndef GIP_DEBUG
+#define GIP_DEBUG 0
+#endif
+#include <stdint.h>
+
+void usblog(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+/* same, never on the console */
+void usblog_quiet(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+/* called once per usb_do_poll(): sends at most one line */
+void usblog_tick(void);
+/* breadcrumb: always printed on the console (first 64), and in the crash ring */
+void usblog_bc(const char *fmt, ...) __attribute__((format(printf, 1, 2)));
+/* last lines, for the libxenon crash screen (c_except.c, weak hook) */
+const char *usblog_crash_tail(void);
+uint64_t usblog_now_ms(void);
+/* remember "vid:pid>driver" for the summary line */
+void usblog_note_enum(unsigned vid, unsigned pid, const char *drv);
+/* "aa bb cc ..." of up to max bytes into out (size >= 3*max+1) */
+void usblog_hex(char *out, const uint8_t *b, int n, int max);
+/* host test / debugging */
+int usblog_find(const char *s, unsigned n);
+unsigned usblog_total(void);
+unsigned usblog_dropped(void);
+
+#endif
