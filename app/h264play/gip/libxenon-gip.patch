diff -ruN
--- a/drivers/usb/gip_proto.c	1969-12-31 21:00:00.000000000 -0300
+++ b/drivers/usb/gip_proto.c	2026-10-27 04:04:42.071076644 -0300
@@ -0,0 +1,319 @@
+/*
+ * gip_proto.c - GIP (Xbox One / Series wired pad) protocol layer.
+ *
+ * Derived code, see gip_proto.h and GIP-CONTROLLER.md "Licensing":
+ *  - xpad (GPL-2.0-or-later): init quirk table + bytes, report 0x20 layout,
+ *    guide ack, rumble.
+ *  - xone (GPL-2.0-or-later): header framing (LEB128), chunk ack layout,
+ *    "sequence never 0".
+ *  - XboxInput / riffmaster-rgh360 (GPL-3.0): identify request, 15-byte
+ *    locale POWER packet, the host-reactive order for Microsoft pads.
+ */
+#include <string.h>
+#include "gip_proto.h"
+
+#define SEQ0 0x00
+
+/* ---- xpad init list (third-party pads) */
+static const uint8_t pkt_power_on[] = { GIP_CMD_POWER, GIP_OPT_INTERNAL, SEQ0, 0x01, 0x00 };
+static const uint8_t pkt_s_init[] = { GIP_CMD_POWER, GIP_OPT_INTERNAL, SEQ0, 0x0f, 0x06 };
+static const uint8_t pkt_extra_input[] = { 0x4d, 0x10, 0x01, 0x02, 0x07, 0x00 };
+static const uint8_t pkt_hori_ack_id[] = {
+    GIP_CMD_ACK, GIP_OPT_INTERNAL, SEQ0, 0x09,
+    0x00, GIP_CMD_IDENTIFY, GIP_OPT_INTERNAL, 0x3a, 0x00, 0x00, 0x00, 0x80, 0x00 };
+static const uint8_t pkt_led_on[] = { GIP_CMD_LED, GIP_OPT_INTERNAL, SEQ0, 0x03, 0x00, 0x01, 0x14 };
+static const uint8_t pkt_auth_done[] = { GIP_CMD_AUTHENTICATE, GIP_OPT_INTERNAL, SEQ0, 0x02, 0x01, 0x00 };
+static const uint8_t pkt_rumble_begin[] = {
+    GIP_CMD_RUMBLE, 0x00, SEQ0, 0x09, 0x00, 0x0f, 0x00, 0x00, 0x1d, 0x1d, 0xff, 0x00, 0x00 };
+static const uint8_t pkt_rumble_end[] = {
+    GIP_CMD_RUMBLE, 0x00, SEQ0, 0x09, 0x00, 0x0f, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
+/* ---- host-reactive sequence (Windows capture via riffmaster PROTOCOL.md, XboxInput) */
+static const uint8_t pkt_identify[] = { GIP_CMD_IDENTIFY, GIP_OPT_INTERNAL, SEQ0, 0x00 };
+static const uint8_t pkt_locale[] = { GIP_CMD_POWER, GIP_OPT_INTERNAL, SEQ0, 0x0f,
+    0x06, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 'U', 'S', 0x00, 0x00, 0x00, 0x00, 0x00, 0x00 };
+
+typedef struct {
+    uint16_t vid, pid;          /* 0 = any */
+    const uint8_t *data;
+    uint8_t len;
+} init_entry_t;
+
+#define E(v, p, a) { (v), (p), (a), (uint8_t)sizeof(a) }
+/* Same order as xpad's xboxone_init_packets[]. */
+static const init_entry_t init_table[] = {
+    E(0x0e6f, 0x0165, pkt_hori_ack_id),
+    E(0x0f0d, 0x0067, pkt_hori_ack_id),
+    E(0x0000, 0x0000, pkt_power_on),
+    E(0x045e, 0x02ea, pkt_s_init),
+    E(0x045e, 0x0b00, pkt_s_init),
+    E(0x045e, 0x0b00, pkt_extra_input),
+    E(0x0000, 0x0000, pkt_led_on),
+    E(0x0000, 0x0000, pkt_auth_done),
+    E(0x24c6, 0x541a, pkt_rumble_begin),
+    E(0x24c6, 0x542a, pkt_rumble_begin),
+    E(0x24c6, 0x543a, pkt_rumble_begin),
+    E(0x24c6, 0x541a, pkt_rumble_end),
+    E(0x24c6, 0x542a, pkt_rumble_end),
+    E(0x24c6, 0x543a, pkt_rumble_end),
+};
+#undef E
+
+static void put(gip_pkt_t *out, const uint8_t *d, int n, uint8_t flags)
+{
+    memset(out, 0, sizeof(*out));
+    memcpy(out->data, d, n);
+    out->len = (uint8_t)n;
+    out->flags = flags;
+}
+
+int gip_build_init(uint16_t vid, uint16_t pid, gip_pkt_t *out, int max)
+{
+    int n = 0;
+    unsigned i;
+    for (i = 0; i < sizeof(init_table) / sizeof(init_table[0]) && n < max; i++) {
+        const init_entry_t *e = &init_table[i];
+        if (e->vid && e->vid != vid) continue;
+        if (e->pid && e->pid != pid) continue;
+        put(&out[n], e->data, e->len, GIP_PF_STAMP_SEQ | GIP_PF_INIT);
+        n++;
+    }
+    if (n > 0) out[n - 1].flags |= GIP_PF_INIT_LAST;
+    return n;
+}
+
+void gip_build_power_on(gip_pkt_t *out, int seq_zero)
+{
+    /* XboxInput's early power-on is exactly 05 20 00 01 00 (sequence 0) */
+    put(out, pkt_power_on, sizeof(pkt_power_on), seq_zero ? 0 : GIP_PF_STAMP_SEQ);
+}
+
+void gip_build_identify(gip_pkt_t *out) { put(out, pkt_identify, sizeof(pkt_identify), GIP_PF_STAMP_SEQ); }
+void gip_build_locale(gip_pkt_t *out) { put(out, pkt_locale, sizeof(pkt_locale), GIP_PF_STAMP_SEQ); }
+void gip_build_led_on(gip_pkt_t *out) { put(out, pkt_led_on, sizeof(pkt_led_on), GIP_PF_STAMP_SEQ); }
+
+void gip_build_ack(gip_pkt_t *out, uint8_t seq, uint8_t cmd, uint16_t received, uint16_t remaining)
+{
+    memset(out, 0, sizeof(*out));
+    out->data[0] = GIP_CMD_ACK;
+    out->data[1] = GIP_OPT_INTERNAL;
+    out->data[2] = seq;                 /* echo the pad's sequence */
+    out->data[3] = 0x09;
+    out->data[4] = 0x00;
+    out->data[5] = cmd;
+    out->data[6] = GIP_OPT_INTERNAL;
+    out->data[7] = (uint8_t)(received & 0xff);
+    out->data[8] = (uint8_t)(received >> 8);
+    out->data[9] = 0x00;
+    out->data[10] = 0x00;
+    out->data[11] = (uint8_t)(remaining & 0xff);
+    out->data[12] = (uint8_t)(remaining >> 8);
+    out->len = 13;
+    out->flags = 0;
+}
+
+void gip_build_rumble(gip_pkt_t *out, uint8_t l, uint8_t r)
+{
+    memset(out, 0, sizeof(*out));
+    out->data[0] = GIP_CMD_RUMBLE;
+    out->data[1] = 0x00;
+    out->data[2] = SEQ0;
+    out->data[3] = 0x09;
+    out->data[4] = 0x00;
+    out->data[5] = 0x0f;                /* all motors */
+    out->data[6] = 0x00;
+    out->data[7] = 0x00;
+    out->data[8] = (uint8_t)(l / 2);
+    out->data[9] = (uint8_t)(r / 2);
+    out->data[10] = 0xff;
+    out->data[11] = 0x00;
+    out->data[12] = 0xff;
+    out->len = 13;
+    out->flags = GIP_PF_STAMP_SEQ;
+}
+
+uint8_t gip_next_seq(uint8_t *ctr)
+{
+    uint8_t s = *ctr;
+    if (s == 0) s = 1;
+    *ctr = (uint8_t)(s + 1);
+    return s;
+}
+
+static int rd_varint(const uint8_t *b, int len, uint32_t *v)
+{
+    uint32_t x = 0;
+    int i;
+    for (i = 0; i < 4 && i < len; i++) {
+        x |= (uint32_t)(b[i] & 0x7f) << (7 * i);
+        if (!(b[i] & 0x80)) { *v = x; return i + 1; }
+    }
+    return 0;
+}
+
+int gip_decode_header(const uint8_t *b, int len, gip_hdr_t *h)
+{
+    int n, off = 3;
+    if (!b || len < 4) return 0;
+    h->cmd = b[0]; h->opt = b[1]; h->seq = b[2];
+    h->plen = 0; h->coff = 0;
+    n = rd_varint(b + off, len - off, &h->plen);
+    if (!n) return 0;
+    off += n;
+    if (h->opt & GIP_OPT_CHUNK) {
+        n = rd_varint(b + off, len - off, &h->coff);
+        if (!n) return 0;
+        off += n;
+    }
+    h->hlen = off;
+    return 1;
+}
+
+static inline int16_t rd_s16(const uint8_t *p) { return (int16_t)(uint16_t)(p[0] | (p[1] << 8)); }
+static inline uint16_t rd_u16(const uint8_t *p) { return (uint16_t)(p[0] | (p[1] << 8)); }
+
+static unsigned char trig8(uint16_t v)
+{
+    if (v > 1023) v = 1023;             /* GIP triggers are 10 bit */
+    return (unsigned char)(v >> 2);     /* 0..255 like the 360 report */
+}
+
+int gip_parse_ex(gip_state_t *st, const uint8_t *b, int len, gip_pkt_t *ack, int *consumed)
+{
+    gip_hdr_t h;
+    int ev = 0;
+    if (consumed) *consumed = 0;
+    if (!b || len < 4 || !gip_decode_header(b, len, &h)) { st->n_short++; return 0; }
+    if (h.cmd == 0x00) return 0;                    /* zero padding: end of data */
+    long total = (long)h.hlen + (long)h.plen;
+    if (total > len) {
+        /* truncated: the 0x20 report is still usable if its 18 bytes are there
+         * (some firmwares pad the length); anything else is dropped */
+        if (!(h.cmd == GIP_CMD_INPUT && len >= 18)) { st->n_short++; return 0; }
+        total = len;
+    }
+    if (consumed) *consumed = (int)total;
+    const uint8_t *p = b + h.hlen;
+    int plen_have = (int)(total - h.hlen);
+
+    if ((h.opt & GIP_OPT_ACK) && ack) {
+        uint32_t received, remaining = 0;
+        if (h.opt & GIP_OPT_CHUNK) {
+            if (h.opt & GIP_OPT_CHUNK_START) {
+                st->chunk_total = h.coff;      /* first chunk: offset = total length */
+                received = h.plen;
+            } else {
+                received = h.coff + h.plen;
+            }
+            remaining = st->chunk_total > received ? st->chunk_total - received : 0;
+        } else {
+            received = h.plen;
+        }
+        gip_build_ack(ack, h.seq, h.cmd, (uint16_t)received, (uint16_t)remaining);
+        st->n_acks++;
+        ev |= GIP_EV_ACK;
+    }
+
+    switch (h.cmd) {
+    case GIP_CMD_INPUT:
+        if (h.opt & GIP_OPT_INTERNAL) break;
+        if (h.hlen != 4 || total < 18) { st->n_short++; break; }
+        {
+            struct controller_data_s *c = &st->c;
+            c->start = !!(b[4] & 0x04);   /* Menu */
+            c->back  = !!(b[4] & 0x08);   /* View */
+            c->a     = !!(b[4] & 0x10);
+            c->b     = !!(b[4] & 0x20);
+            c->x     = !!(b[4] & 0x40);
+            c->y     = !!(b[4] & 0x80);
+            c->up    = !!(b[5] & 0x01);
+            c->down  = !!(b[5] & 0x02);
+            c->left  = !!(b[5] & 0x04);
+            c->right = !!(b[5] & 0x08);
+            c->lb    = !!(b[5] & 0x10);
+            c->rb    = !!(b[5] & 0x20);
+            c->s1_z  = !!(b[5] & 0x40);
+            c->s2_z  = !!(b[5] & 0x80);
+            c->lt    = trig8(rd_u16(b + 6));
+            c->rt    = trig8(rd_u16(b + 8));
+            /* Raw GIP sticks use the same convention as the raw 360 report
+             * usbctrl.c hands out (Y positive = up): no sign flip. */
+            c->s1_x  = rd_s16(b + 10);
+            c->s1_y  = rd_s16(b + 12);
+            c->s2_x  = rd_s16(b + 14);
+            c->s2_y  = rd_s16(b + 16);
+        }
+        st->have_input = 1;
+        st->n_input++;
+        ev |= GIP_EV_INPUT;
+        break;
+
+    case GIP_CMD_VIRTUAL_KEY:
+        if (plen_have < 1) { st->n_short++; break; }
+        st->c.logo = (p[0] & 0x03) ? 1 : 0;
+        st->n_guide++;
+        ev |= GIP_EV_GUIDE;
+        break;
+
+    case GIP_CMD_ANNOUNCE:
+        if (!(h.opt & GIP_OPT_INTERNAL)) break;
+        if (plen_have >= 12) {
+            st->ann_vid = rd_u16(p + 8);
+            st->ann_pid = rd_u16(p + 10);
+        }
+        st->n_announce++;
+        ev |= GIP_EV_ANNOUNCE;
+        break;
+
+    case GIP_CMD_IDENTIFY:
+        if (!(h.opt & GIP_OPT_INTERNAL)) break;
+        st->n_identify++;
+        ev |= GIP_EV_IDENTIFY;
+        /* chunked reply ends with a zero-length chunk; an unchunked reply is
+         * complete by itself */
+        if (!(h.opt & GIP_OPT_CHUNK) || h.plen == 0) ev |= GIP_EV_IDENTIFY_DONE;
+        break;
+
+    case GIP_CMD_STATUS:
+        ev |= GIP_EV_STATUS;
+        break;
+
+    default:
+        st->n_other++;
+        break;
+    }
+    return ev;
+}
+
+int gip_parse(gip_state_t *st, const uint8_t *b, int len, gip_pkt_t *ack)
+{
+    return gip_parse_ex(st, b, len, ack, NULL);
+}
+
+typedef struct { uint16_t pid; const char *name; } ms_model_t;
+static const ms_model_t ms_models[] = {
+    { 0x02d1, "Xbox One" },
+    { 0x02dd, "Xbox One (2015 fw)" },
+    { 0x02e3, "Xbox One Elite" },
+    { 0x02ea, "Xbox One S" },
+    { 0x0b00, "Xbox Elite Series 2" },
+    { 0x0b0a, "Xbox Adaptive" },
+    { 0x0b12, "Xbox Series X|S" },
+};
+
+int gip_is_known_pid(uint16_t vid, uint16_t pid)
+{
+    unsigned i;
+    if (vid != 0x045e) return 0;
+    for (i = 0; i < sizeof(ms_models) / sizeof(ms_models[0]); i++)
+        if (ms_models[i].pid == pid) return 1;
+    return 0;
+}
+
+const char *gip_model_name(uint16_t vid, uint16_t pid)
+{
+    unsigned i;
+    if (vid == 0x045e)
+        for (i = 0; i < sizeof(ms_models) / sizeof(ms_models[0]); i++)
+            if (ms_models[i].pid == pid) return ms_models[i].name;
+    return "GIP pad";
+}
diff -ruN
--- a/drivers/usb/gip_proto.h	1969-12-31 21:00:00.000000000 -0300
+++ b/drivers/usb/gip_proto.h	2026-10-27 04:04:42.074354235 -0300
@@ -0,0 +1,117 @@
+/*
+ * gip_proto.h - Xbox One / Series "Game Input Protocol" (GIP) over wired USB.
+ *
+ * Pure protocol layer (no USB, no malloc, no globals): builds the host->pad
+ * packets and parses pad->host packets into the libxenon
+ * struct controller_data_s.  Host-testable (hosttest/test_gip.c).
+ *
+ * Sources (see app/h264play/GIP-CONTROLLER.md, "Licensing"):
+ *  - Linux xpad (GPL-2.0-or-later): report 0x20 layout, xpad init quirk table
+ *    (third-party pads), guide ack, rumble layout.
+ *  - medusalix/xone (GPL-2.0-or-later): header/varint framing, chunk ack.
+ *  - XboxInput (GPL-3.0) and riffmaster-rgh360 docs/PROTOCOL.md (GPL-3.0):
+ *    the host-reactive sequence that works for 045e:0b12 on an Xbox 360 USB
+ *    host (power-on, IDENTIFY on announce, chunk acks, 15-byte locale POWER,
+ *    power-on, LED; no auth), and its exact bytes.
+ */
+#ifndef GIP_PROTO_H
+#define GIP_PROTO_H
+
+#include <stdint.h>
+#include <input/input.h>
+
+/* GIP commands (byte 0 of every packet) */
+#define GIP_CMD_ACK          0x01
+#define GIP_CMD_ANNOUNCE     0x02
+#define GIP_CMD_STATUS       0x03
+#define GIP_CMD_IDENTIFY     0x04
+#define GIP_CMD_POWER        0x05
+#define GIP_CMD_AUTHENTICATE 0x06
+#define GIP_CMD_VIRTUAL_KEY  0x07   /* Guide/Xbox button */
+#define GIP_CMD_RUMBLE       0x09
+#define GIP_CMD_LED          0x0a
+#define GIP_CMD_FIRMWARE     0x0c
+#define GIP_CMD_INPUT        0x20
+
+/* options (byte 1) */
+#define GIP_OPT_ACK          0x10
+#define GIP_OPT_INTERNAL     0x20
+#define GIP_OPT_CHUNK_START  0x40
+#define GIP_OPT_CHUNK        0x80
+
+#define GIP_MAX_PKT          64     /* full-speed interrupt mps */
+#define GIP_MAX_INIT         8      /* longest init list for one model is 5 */
+
+/* gip_pkt_t.flags */
+#define GIP_PF_STAMP_SEQ     0x01   /* byte 2 gets the next host sequence number at send time */
+#define GIP_PF_INIT          0x02   /* part of the init sequence */
+#define GIP_PF_INIT_LAST     0x04   /* last packet of the init sequence */
+#define GIP_PF_EARLY_POWER   0x08   /* the first power-on: start reading when it completes */
+
+typedef struct {
+    uint8_t len;
+    uint8_t flags;
+    uint8_t data[GIP_MAX_PKT];
+} gip_pkt_t;
+
+typedef struct {
+    uint8_t cmd, opt, seq;
+    uint32_t plen;        /* payload length (LEB128) */
+    uint32_t coff;        /* chunk offset (LEB128, only with GIP_OPT_CHUNK) */
+    int hlen;             /* header length in bytes */
+} gip_hdr_t;
+
+/* Parser state for one pad (kept by the USB glue, one per pad). */
+typedef struct {
+    struct controller_data_s c;   /* last published state (input + guide) */
+    int have_input;               /* got at least one valid 0x20 report */
+    uint32_t chunk_total;         /* total length announced by the last CHUNK_START */
+    unsigned n_input, n_guide, n_announce, n_acks, n_short, n_other, n_identify;
+    uint16_t ann_vid, ann_pid;    /* from the last announce */
+} gip_state_t;
+
+/* gip_parse() return bits */
+#define GIP_EV_INPUT         0x01   /* st->c changed from a 0x20 report */
+#define GIP_EV_GUIDE         0x02   /* st->c.logo changed from a 0x07 report */
+#define GIP_EV_ANNOUNCE      0x04   /* pad (re)announced itself */
+#define GIP_EV_ACK           0x08   /* *ack was filled and must be sent */
+#define GIP_EV_IDENTIFY      0x10   /* an identify reply (chunk) arrived */
+#define GIP_EV_IDENTIFY_DONE 0x20   /* ... and it was the last one */
+#define GIP_EV_STATUS        0x40
+
+/* Decode the variable-length GIP header at b.  0 on error. */
+int gip_decode_header(const uint8_t *b, int len, gip_hdr_t *h);
+
+/* xpad init list for (vid,pid) (xpad xboxone_init_packets order).  Packets
+ * get GIP_PF_STAMP_SEQ|GIP_PF_INIT, the last one also GIP_PF_INIT_LAST.
+ * Used for third-party pads.  Returns the number of packets (<= max). */
+int gip_build_init(uint16_t vid, uint16_t pid, gip_pkt_t *out, int max);
+
+/* Host-reactive sequence (Microsoft pads, as XboxInput / Windows do it) */
+void gip_build_power_on(gip_pkt_t *out, int seq_zero);  /* 05 20 ss 01 00 */
+void gip_build_identify(gip_pkt_t *out);                /* 04 20 ss 00 */
+void gip_build_locale(gip_pkt_t *out);                  /* 05 20 ss 0f 06 00.. 'U' 'S' 00.. */
+void gip_build_led_on(gip_pkt_t *out);                  /* 0a 20 ss 03 00 01 14 */
+
+/* Ack for a packet that asked for one (opt & GIP_OPT_ACK).  Unchunked:
+ * same bytes as xpad's mode_report_ack for cmd 0x07.  Chunked: xone's
+ * gip_pkt_acknowledge with received/remaining. */
+void gip_build_ack(gip_pkt_t *out, uint8_t seq, uint8_t cmd, uint16_t received, uint16_t remaining);
+
+/* Rumble (xpad layout): l = strong/left motor, r = weak/right, 0..255. */
+void gip_build_rumble(gip_pkt_t *out, uint8_t l, uint8_t r);
+
+/* Host sequence counter: 1..255, never 0 (xone: "sequence is always > 0"). */
+uint8_t gip_next_seq(uint8_t *ctr);
+
+/* Parse the FIRST packet in buf.  Updates st->c in place; fills *ack when the
+ * packet requested an acknowledgement.  *consumed (if not NULL) = bytes of
+ * that packet (header + payload), 0 if buf holds no further packet.  Never
+ * reads past len.  A USB transfer can carry several GIP packets. */
+int gip_parse_ex(gip_state_t *st, const uint8_t *buf, int len, gip_pkt_t *ack, int *consumed);
