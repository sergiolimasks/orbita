+/*  *********************************************************************
+    *  usb_open_pipe_interval(dev,epdesc,interval_ms)
+    *
+    *  usb_open_pipe() for an interrupt endpoint that must be polled at its
+    *  bInterval (Xbox One / Series GIP pads).  Other pipe types ignore it.
+    ********************************************************************* */
+
+int usb_open_pipe_interval(usbdev_t *dev,usb_endpoint_descr_t *epdesc,int interval_ms)
+{
+    int res;
+    int flags = 0;
+
+    if (USB_ENDPOINT_DIR_IN(epdesc->bEndpointAddress)) flags |= UP_TYPE_IN;
+    else flags |= UP_TYPE_OUT;
+
+    switch (epdesc->bmAttributes & USB_ENDPOINT_TYPE_MASK) {
+	case USB_ENDPOINT_TYPE_CONTROL:	flags |= UP_TYPE_CONTROL; break;
+	case USB_ENDPOINT_TYPE_ISOCHRONOUS: flags |= UP_TYPE_ISOC; break;
+	case USB_ENDPOINT_TYPE_BULK:	flags |= UP_TYPE_BULK; break;
+	case USB_ENDPOINT_TYPE_INTERRUPT:
+	    flags |= UP_TYPE_INTR;
+	    if (interval_ms < 1) interval_ms = 1;
+	    if (interval_ms > 255) interval_ms = 255;
+	    flags |= interval_ms << UP_IVAL_SHIFT;
+	    break;
+	}
+
+    res = usb_create_pipe(dev,
+			  epdesc->bEndpointAddress,
+			  GETUSBFIELD(epdesc,wMaxPacketSize),
+			  flags);
+
+    if (res < 0) return res;
+
+    return epdesc->bEndpointAddress;
+}
