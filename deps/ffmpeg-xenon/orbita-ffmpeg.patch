+/*
+ * XCloud360: Xenon (Xbox 360) VMX128 safety switch.
+ *
+ * This file is part of FFmpeg (XCloud360 local patch), LGPL 2.1+.
+ *
+ * The Xenon vector unit does NOT implement these AltiVec instructions:
+ *   vmsumubm vmsummbm vmsumuhm vmsumuhs vmsumshm vmsumshs
+ *   vmhaddshs vmhraddshs vmladduhm
+ *   vmuleub vmuloub vmulesb vmulosb vmuleuh vmulouh vmulesh vmulosh
+ *   vsum4ubs vsum4sbs vsum4shs vsum2sws vsumsws
+ * i.e. the intrinsics vec_msum, vec_msums, vec_mladd, vec_madds, vec_mradds,
+ * vec_mule, vec_mulo, vec_sum4s, vec_sum2s and vec_sums are unusable.
+ * (Free60 gcc-9.2.0.diff disables their patterns; Xenia leaves them
+ * unimplemented; G. Bobic, gcc@gcc.gnu.org 2007-08-21.)
+ *
+ * XCLOUD360_VMX_SAFE=1 selects Xenon-safe code. It is automatic when XENON
+ * is defined and can be forced with -DXCLOUD360_VMX_SAFE=1 (used by the
+ * qemu linux-ppc reference build so it runs the very same vector code).
+ */
+#ifndef AVCODEC_PPC_XCLOUD360_VMX_H
+#define AVCODEC_PPC_XCLOUD360_VMX_H
+
+#if defined(XENON) && !defined(XCLOUD360_VMX_SAFE)
+#define XCLOUD360_VMX_SAFE 1
+#endif
+#ifndef XCLOUD360_VMX_SAFE
+#define XCLOUD360_VMX_SAFE 0
+#endif
+
+#endif /* AVCODEC_PPC_XCLOUD360_VMX_H */
