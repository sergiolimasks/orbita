+++ ffmpeg-xenon-mt-altivec/libavcodec/ppc/h264_qpel8_xenon.h	2026-10-27 03:23:32.727911853 -0300
@@ -0,0 +1,170 @@
+/*
+ * XCloud360 v0.21.26: H.264 luma qpel 8x8 (put/avg, all 16 positions) in
+ * Xenon-safe AltiVec. ffmpeg 0.10.2 only has the 16x16 AltiVec MC; 8x8,
+ * 8x16 and 16x8 partitions (most of a Main-profile game stream) ran in C.
+ *
+ * 8 pixels = one vector of 8 signed shorts, so every row is a single vector:
+ *   h/v: 20*(p0+p1) - 5*(m1+p2) + (m2+p3) + 16 >> 5   (fits s16)
+ *   hv : stage 1 as above without rounding (s16), stage 2 in s32
+ *        ((t2+t3)*20 - (t1+t4)*5 + (t0+t5) + 512) >> 10
+ * Only legal Xenon VMX128 instructions (lvx/stvewx/vperm/vmrghb/vadduhm/
+ * vsubuhm/vslh/vsrah/vupkhsh/vupklsh/vadduwm/vslw/vsraw/vpkswss/vpkshus/
+ * vavgub): no vmladd/vmsum/vmule (see README-XCLOUD360.md). Bit-exact with
+ * the C version (checked with the qemu harness: hosttest notes in
+ * DECODE-PERF.md of the app).
+ * Included from h264_altivec.c after its H264_MC macro and helpers.
+ */
+
+/* 8 bytes at p (any alignment) into lanes 0-7 */
+static av_always_inline vec_u8 xc_ld8(const uint8_t *p)
+{
+    vec_u8 a = vec_ld(0, p), b = vec_ld(7, p);
+    return vec_perm(a, b, vec_lvsl(0, p));
+}
+
+static av_always_inline vec_s16 xc_ld8s16(const uint8_t *p)
+{
+    return (vec_s16)vec_mergeh(vec_splat_u8(0), xc_ld8(p));
+}
+
+/* lanes 0-7 of v to d (8 bytes) */
