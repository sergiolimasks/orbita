--- ffmpeg-xenon/libavcodec/xc_prof.h	1969-12-31 21:00:00.000000000 -0300
+++ ffmpeg-xenon-mt-altivec/libavcodec/xc_prof.h	2026-10-27 03:00:58.820436225 -0300
@@ -0,0 +1,60 @@
+/*
+ * XCloud360 v0.21.25: decoder profiling counters (mftb), per hardware thread.
+ * Inert unless xc_prof_on != 0 (one load + branch per call site).
+ * Read by the app (source/dec/xc_decdiag.c) as running totals; it diffs
+ * snapshots, nothing here is ever reset.
+ */
+#ifndef AVCODEC_XC_PROF_H
+#define AVCODEC_XC_PROF_H
+#include <stdint.h>
+
+enum { XCP_ENTROPY = 0, XCP_RECON, XCP_MC, XCP_DEBLOCK, XCP_AWAIT, XCP_DECODE, XCP_NKIND };
+
+typedef struct {
+    volatile uint64_t tb[XCP_NKIND];
+    volatile uint32_t frames;
+    uint32_t pad[7];               /* one 128-byte line per thread on Xenon */
+} xc_prof_thr_t;
+
+typedef struct {
+    xc_prof_thr_t t[8];
+    volatile uint32_t slices, slices_nonref, slices_cabac, slices_idr;
+    volatile int profile_idc, level_idc, mb_w, mb_h;
+} xc_prof_t;
+
+extern xc_prof_t xc_prof;
+extern volatile int xc_prof_on;
+
+#if defined(__PPC__) || defined(__powerpc__)
+static inline uint64_t xcp_mftb(void)
+{
+    uint32_t hi, lo, hi2;
+    do {
+        __asm__ __volatile__("mftbu %0" : "=r"(hi));
+        __asm__ __volatile__("mftb %0" : "=r"(lo));
+        __asm__ __volatile__("mftbu %0" : "=r"(hi2));
+    } while (hi != hi2);
+    return ((uint64_t)hi << 32) | lo;
+}
+static inline int xcp_thr(void)
+{
+    uint32_t pir;
+    __asm__ __volatile__("mfspr %0,1023" : "=r"(pir));
+    return (int)(pir & 7);
+}
+#else
+static inline uint64_t xcp_mftb(void) { return 0; }
+static inline int xcp_thr(void) { return 0; }
+#endif
+
+static inline uint64_t xcp_t0(void) { return xc_prof_on ? xcp_mftb() : 0; }
+static inline void xcp_add(int k, uint64_t t0)
+{
+    if (t0) xc_prof.t[xcp_thr()].tb[k] += xcp_mftb() - t0;
+}
+
+/* value-returning and void call wrappers */
+#define XCP_E(kind, expr) ({ uint64_t xcp_t_ = xcp_t0(); __typeof__(expr) xcp_r_ = (expr); xcp_add(kind, xcp_t_); xcp_r_; })
+#define XCP_V(kind, stmt) do { uint64_t xcp_t_ = xcp_t0(); stmt; xcp_add(kind, xcp_t_); } while (0)
+
+#endif
