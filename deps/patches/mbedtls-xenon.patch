# mbedtls 3.4.0 patch for Xenon. Modeled on green-nx mbedtls-switch.patch.
# Apply from libpeer/third_party/mbedtls:
#   git apply /path/to/mbedtls-xenon.patch
#
# Same 3 flips as Switch port plus __XENON__ guard in timing.c.
# The MBEDTLS_SSL_DTLS_SRTP flip is ALSO applied by libpeer's PC CMakeLists
# (file(READ)+string(REPLACE)+file(WRITE) block) -- keep both idempotent.

diff --git a/include/mbedtls/mbedtls_config.h b/include/mbedtls/mbedtls_config.h
--- a/include/mbedtls/mbedtls_config.h
+++ b/include/mbedtls/mbedtls_config.h
@@ -477,7 +477,7 @@
  *
  * Uncomment to use your own hardware entropy collector.
  */
-//#define MBEDTLS_ENTROPY_HARDWARE_ALT
+#define MBEDTLS_ENTROPY_HARDWARE_ALT

 /**
  * \def MBEDTLS_AES_ROM_TABLES
@@ -1068,7 +1068,7 @@
  *
  * Uncomment this macro to disable the built-in platform entropy functions.
  */
-//#define MBEDTLS_NO_PLATFORM_ENTROPY
+#define MBEDTLS_NO_PLATFORM_ENTROPY

 /**
  * \def MBEDTLS_ENTROPY_FORCE_SHA256
@@ -1788,7 +1788,7 @@
  *
  * Uncomment this to enable support for use_srtp extension.
  */
-//#define MBEDTLS_SSL_DTLS_SRTP
+#define MBEDTLS_SSL_DTLS_SRTP

 /**
  * \def MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE
@@ -2741,7 +2741,7 @@
  *
  * This module provides networking routines.
  */
-#define MBEDTLS_NET_C
+//#define MBEDTLS_NET_C

 /**
  * \def MBEDTLS_OID_C
diff --git a/library/timing.c b/library/timing.c
--- a/library/timing.c
+++ b/library/timing.c
@@ -27,7 +27,7 @@

 #if !defined(unix) && !defined(__unix__) && !defined(__unix) && \
     !defined(__APPLE__) && !defined(_WIN32) && !defined(__QNXNTO__) && \
-    !defined(__HAIKU__) && !defined(__midipix__)
+    !defined(__HAIKU__) && !defined(__midipix__) && !defined(__XENON__)
 #error "This module only works on Unix and Windows, see MBEDTLS_TIMING_C in mbedtls_config.h"
 #endif
